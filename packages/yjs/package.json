{
  "name": "@jantt/yjs",
  "version": "1.1.0",
  "description": "Real-time multiplayer CRDT Yjs binding for Jantt JSON Gantt chart engine",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "dependencies": {
    "@jantt/core": "^1.1.0",
    "y-protocols": "^1.0.7"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^5.0.5",
    "yjs": "^13.6.14"
  }
}
