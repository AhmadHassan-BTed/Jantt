{
  "name": "@jantt/mcp",
  "version": "1.1.0",
  "description": "Official Model Context Protocol (MCP) server for Jantt project timelines and Gantt charts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadHassan-BTed/Jantt.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/AhmadHassan-BTed/Jantt#readme",
  "bugs": {
    "url": "https://github.com/AhmadHassan-BTed/Jantt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
