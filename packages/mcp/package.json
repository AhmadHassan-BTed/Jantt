{
  "name": "@jantt/mcp",
  "version": "1.1.0",
  "description": "Official Model Context Protocol (MCP) server for Jantt project timelines and Gantt charts",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "jantt-mcp": "./bin/jantt-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node ./bin/jantt-mcp.js"
  },
  "dependencies": {
    "@jantt/core": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^5.0.5"
  }
}
