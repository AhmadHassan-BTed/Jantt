{
  "name": "@jantt/svelte",
  "version": "1.1.0",
  "description": "Svelte wrapper and action for Jantt JSON Gantt chart engine",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "dependencies": {
    "@jantt/core": "^1.1.0"
  },
  "devDependencies": {
    "svelte": "^4.2.18",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5"
  }
}
