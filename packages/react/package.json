{
  "name": "@jantt/react",
  "version": "1.1.0",
  "description": "React wrapper for Jantt JSON Gantt chart engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadHassan-BTed/Jantt.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/AhmadHassan-BTed/Jantt#readme",
  "bugs": {
    "url": "https://github.com/AhmadHassan-BTed/Jantt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@jantt/core": "^1.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^3.9.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
