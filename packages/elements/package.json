{
  "name": "@jantt/elements",
  "version": "1.1.0",
  "description": "Standard Custom Elements & Web Components for Jantt JSON Gantt chart engine (<jantt-timeline>)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadHassan-BTed/Jantt.git",
    "directory": "packages/elements"
  },
  "homepage": "https://github.com/AhmadHassan-BTed/Jantt#readme",
  "bugs": {
    "url": "https://github.com/AhmadHassan-BTed/Jantt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/jantt-elements.js",
  "jsdelivr": "./dist/jantt-elements.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/jantt-elements.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@jantt/core": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
