{
  "name": "@jantt/core",
  "version": "1.1.0",
  "description": "Framework-agnostic interactive JSON Gantt chart engine (one tiny runtime dependency: fflate)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadHassan-BTed/Jantt.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AhmadHassan-BTed/Jantt#readme",
  "bugs": {
    "url": "https://github.com/AhmadHassan-BTed/Jantt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/theme.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./style.css": "./dist/theme.css",
    "./dist/theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^3.9.1"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
