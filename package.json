{
  "name": "jantt-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Jantt - The JSON Gantt chart engine",
  "workspaces": [
    "packages/*",
    "cli",
    "apps/*"
  ],
  "scripts": {
