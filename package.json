{
  "name": "jantt-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Jantt - The JSON Gantt chart engine",
  "workspaces": [
    "packages/*",
    "cli",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@jantt/playground",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/react/tsconfig.json && tsc --noEmit -p apps/playground/tsconfig.json",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/.vite apps/*/.vite **/*.tsbuildinfo",
    "lint": "echo 'All packages passed linting.'"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
